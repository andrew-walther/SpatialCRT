# latexmk settings for the CTJ manuscript, reading layout and supplement.
# Author: Andrew Walther. Created: 2026-10-13.
# Build intermediates (.aux, .log, .bbl, ...) go to the hidden, gitignored
# .build/ folder so this directory holds only sources and PDFs. The PDFs are
# still written next to the .tex files. sagej.cls and SageV.bst are symlinks
# to ../SAGE_Journal_Template, so no TEXINPUTS/BSTINPUTS setup is needed.
# BibTeX runs inside .build/, where \bibliography{../SpatialCRT_IncidenceDesign}
# points back to this folder; the SpatialCRT_IncidenceDesign.bib symlink here
# resolves it (plain pdflatex builds reach ../ directly).
$pdf_mode = 1;
$aux_dir = '.build';
